# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Configuration
HOST=localhost
PORT=8000

# Web UI Toggle — set false to disable all HTML endpoints (API-only mode)
WEB_ENABLED=true

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/paragonka_db

# Security Configuration
SECRET_KEY=change-me-to-a-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Pool Configuration
DB_POOL_SIZE=5
DB_POOL_PRE_PING=true

# Worker Configuration (for production)
WORKERS=4
THREADS_PER_WORKER=4

# Granian Server Configuration
GRANIAN_BACKLOG=2048
GRANIAN_GRACEFUL_TIMEOUT=30
GRANIAN_TIMEOUT=30
GRANIAN_KEEPALIVE=5
# --- docker-compose.yml (production stack) ---
# SECRET_KEY is REQUIRED by docker compose (no default).
# DB_USER / DB_PASSWORD / DB_NAME configure both web and db services.
